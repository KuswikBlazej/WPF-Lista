<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Notatki" Height="480" Width="300">

    <StackPanel>
        <Label Content="Notatki"
               FontSize="20"
               Margin="9"/>

        <ListView x:Name="NotesList"
                  Height="300"
                  Margin="5">

            <ListView.Resources>
                <Style TargetType="ListViewItem">
                    <Setter Property="FontSize" Value="17"/>
                </Style>
            </ListView.Resources>

            <ListView.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Content}"
                               TextWrapping="Wrap"/>
                </DataTemplate>
            </ListView.ItemTemplate>

        </ListView>

        <Button x:Name="Add"
                Content="Dodaj Notatkę"
                Click="Add_Click"
                FontSize="18"
                Margin="5"/>

        <Button Content="Zapisz Notatki"
                Click="Save_Click"
                FontSize="18"
                Margin="5"/>

    </StackPanel>
</Window>